{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix web ci",
  "buildCommand": "npm --prefix web run build",
  "outputDirectory": "web/out",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{src/haa/**,app.py}",
      "excludeFiles": "{web/**,tests/**,api/tests/**,docs/**,static/**,.streamlit/**,**/__pycache__/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.py" }
  ]
}
