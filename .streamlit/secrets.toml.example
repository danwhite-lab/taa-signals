# Copy these values to your deployment platform's secret settings. Do not commit
# a real secrets.toml file. The publishable key is safe for a browser/client;
# row-level security protects the portfolio rows. Never add a service-role key.
[supabase]
url = "https://YOUR_PROJECT_REF.supabase.co"
publishable_key = "sb_publishable_YOUR_KEY"

# Google client ID/secret belong only in Supabase's Google provider settings.
# No Google secret or Streamlit [auth] configuration is needed in this app.
